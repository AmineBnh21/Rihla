# Site Next.js : clé publique (anon) uniquement, jamais la clé service.
# Copie ce fichier en .env.local et remplis les valeurs.
# Si ces variables sont absentes, le site affiche des données de démonstration (mock).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cle_publique

# Identifiant partenaire Travelpayouts (public, dans les liens Aviasales)
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=ton_id_partenaire
